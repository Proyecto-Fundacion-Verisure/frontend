# Copia este archivo como .env.local para valores no versionados.
VITE_API_URL=http://localhost:8080/api
VITE_APP_ORIGIN=http://localhost:5173

# Interruptor de mocks en dos niveles · src/api/mocks.js
#   VITE_USE_MOCKS=false                 apaga todos los módulos
#   VITE_USE_<MODULO>_MOCKS=false        apaga solo uno, y manda sobre la global
# Módulos: AUTH, REGISTRATION, CATALOG, ACTIVITY, ORG_REGISTER, ORG_ACTIVITY,
# ORG_PROPOSAL, PROPOSAL_INBOX, CLOSURE, ORG, PROPOSAL, DASHBOARD
#
# CATALOG es el catálogo público y la ficha; ACTIVITY es el listado de
# administración, su detalle, cancelar y publicar. ORG_REGISTER es el alta de
# entidad; ORG_ACTIVITY y ORG_PROPOSAL, sus actividades y propuestas;
# PROPOSAL_INBOX, la bandeja de propuestas del admin; CLOSURE, el cierre de
# participación, el certificado y la cola de cierres. ORG (cuentas de entidad y
# dashboard de la entidad) y PROPOSAL (el formulario público de la landing) no
# tienen backend todavía.
#
# Los nueve primeros ya están integrados: la lista INTEGRATED de mocks.js los
# manda al backend real aunque la global esté encendida. Su variable de módulo
# sigue mandando sobre esa lista, así que para trabajar con el backend apagado se
# puede poner VITE_USE_AUTH_MOCKS=true.
VITE_USE_MOCKS=true
VITE_USE_AUTH_MOCKS=false
VITE_USE_REGISTRATION_MOCKS=false
VITE_USE_CATALOG_MOCKS=false
VITE_USE_ACTIVITY_MOCKS=false
VITE_USE_ORG_REGISTER_MOCKS=false
VITE_USE_ORG_ACTIVITY_MOCKS=false
VITE_USE_ORG_PROPOSAL_MOCKS=false
VITE_USE_PROPOSAL_INBOX_MOCKS=false
VITE_USE_CLOSURE_MOCKS=false
