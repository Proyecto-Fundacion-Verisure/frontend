VITE_API_URL=http://localhost:8080/api
VITE_APP_ORIGIN=http://localhost:5173
VITE_USE_MOCKS=false

# Los mocks son opt-in. Para simular toda la API usa true. También se puede
# activar un único módulo con VITE_USE_<MODULO>_MOCKS=true.
