# Copia este archivo como .env.local para valores no versionados.
VITE_API_URL=http://localhost:8080/api
VITE_APP_ORIGIN=http://localhost:5173

# Interruptor de mocks en dos niveles · src/api/mocks.js
#   VITE_USE_MOCKS=false                 apaga todos los módulos
#   VITE_USE_<MODULO>_MOCKS=false        apaga solo uno, y manda sobre la global
# Módulos: AUTH, REGISTRATION, CATALOG, ACTIVITY, CLOSURE, PROPOSAL, ORG, DASHBOARD
#
# CATALOG es el catálogo público y la ficha; ACTIVITY es el listado de
# administración y el de la entidad. Van por separado porque el primero ya tiene
# backend y el segundo no.
#
# AUTH, REGISTRATION y CATALOG ya están integrados: la lista INTEGRATED de
# mocks.js los manda al backend real aunque la global esté encendida. Su variable
# de módulo sigue mandando sobre esa lista, así que para trabajar con el backend
# apagado se puede poner VITE_USE_AUTH_MOCKS=true.
VITE_USE_MOCKS=true
VITE_USE_AUTH_MOCKS=false
VITE_USE_REGISTRATION_MOCKS=false
VITE_USE_CATALOG_MOCKS=false
