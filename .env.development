VITE_API_URL=http://localhost:8080/api
VITE_APP_ORIGIN=http://localhost:5173

# Mocks: la global apaga todos los módulos, la de módulo manda sobre ella.
# Login e inscripciones ya están integrados contra el backend de verdad; el
# resto de módulos no tiene backend todavía y sigue en falso.
#
# Estas dos líneas son redundantes con la lista INTEGRATED de src/api/mocks.js,
# que es la que de verdad garantiza el backend real. Se dejan porque son lo
# primero que se mira al depurar un login que no entra.
VITE_USE_AUTH_MOCKS=false
VITE_USE_REGISTRATION_MOCKS=false
