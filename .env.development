VITE_API_URL=http://localhost:8080/api
VITE_APP_ORIGIN=http://localhost:5173

# Mocks: la global apaga todos los módulos, la de módulo manda sobre ella.
# Login, inscripciones, catálogo, actividades, alta de entidad, actividades y
# propuestas de la entidad, bandeja de propuestas, cierres, dashboard y cuentas
# de entidad ya están integrados contra el backend de verdad; el resto de
# módulos no tiene backend todavía y sigue en falso.
#
# Siguen en mock: ORG (/org/dashboard) y PROPOSAL (el formulario público de la
# landing).
#
# Estas líneas son redundantes con la lista INTEGRATED de src/api/mocks.js, que
# es la que de verdad garantiza el backend real. Se dejan porque son lo primero
# que se mira al depurar un login que no entra.
VITE_USE_AUTH_MOCKS=false
VITE_USE_REGISTRATION_MOCKS=false
VITE_USE_CATALOG_MOCKS=false
VITE_USE_ACTIVITY_MOCKS=false
VITE_USE_ORG_REGISTER_MOCKS=false
VITE_USE_ORG_ACTIVITY_MOCKS=false
VITE_USE_ORG_PROPOSAL_MOCKS=false
VITE_USE_PROPOSAL_INBOX_MOCKS=false
VITE_USE_CLOSURE_MOCKS=false
VITE_USE_DASHBOARD_MOCKS=false
VITE_USE_ORG_ACCOUNT_MOCKS=false
