{
  "name": "verisure-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "arch:check": "node scripts/check-architecture.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "npm run test:run && npm run build && npm run arch:check && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "axios": "^1.21.0",
    "lucide-react": "^1.34.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.1.4",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "description": "Plataforma de voluntariado corporativo: catálogo, inscripciones, cierres y dashboards de impacto.",
